PORT=5000
MONGO_URI=mongodb://localhost:27017/registro_asistencia

# Resend Email Configuration
# Obtén tu API key en: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Email desde el cual se enviarán las notificaciones
# Para testing puedes usar: onboarding@resend.dev
# Para producción, configura tu propio dominio en Resend
EMAIL_FROM=onboarding@resend.dev
# Nombre de la aplicación que aparecerá en los emails
APP_NAME=Sistema de Registro de Asistencia
